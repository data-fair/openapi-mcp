{
  "name": "@data-fair/openapi-mcp",
  "version": "0.7.0",
  "description": "MCP tools for AI agents from OpenAPI documents annotated with x-agent",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Alban Mouton <alban.mouton@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-fair/openapi-mcp.git"
  },
  "homepage": "https://github.com/data-fair/openapi-mcp#readme",
  "bugs": {
    "url": "https://github.com/data-fair/openapi-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "ai-agents",
    "data-fair",
    "json-layout",
    "x-agent"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/mcp": {
      "types": "./dist/adapters/mcp.d.ts",
      "default": "./dist/adapters/mcp.js"
    }
  },
  "bin": {
    "openapi-mcp": "./dist/bin/server.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "check-types": "tsc",
    "test": "NODE_ENV=test node --test --test-force-exit 'test/**/*.test.ts'",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "quality": "npm run lint && npm run check-types && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "debug": "^4.4.1",
    "form-data": "^4.0.6",
    "mime-types": "^3.0.2"
  },
  "peerDependencies": {
    "@json-layout/agents": "^0.2.0",
    "@json-layout/core": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "@json-layout/agents": {
      "optional": true
    },
    "@json-layout/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@data-fair/lib-utils": "^1.5.0",
    "@json-layout/agents": "^0.2.0",
    "@json-layout/core": "^2.11.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/debug": "^4.1.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.32.0",
    "neostandard": "^0.12.0",
    "typescript": "^5.8.3",
    "zod": "^4.6.5"
  }
}
